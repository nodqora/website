{
  // Static assets only — there is no Worker script, so no "main" entry. Cloudflare serves the
  // files in public/ directly, including _headers and robots.txt.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "nodqora",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./public"
  },
  // The hostname is bound here rather than clicked into the dashboard, so the domain binding is
  // reviewable and survives a rebuild of the account. Cloudflare creates the DNS record and issues
  // the certificate itself; there is nothing to add in the DNS tab.
  //
  // Apex only, deliberately. www was bound here too and Cloudflare created an AAAA record for it
  // without the matching A, so it resolved over IPv6 and failed for every IPv4-only client — worse
  // than not existing, because it failed depending on who was asking. One hostname also retires the
  // duplicate-content question that the rel="canonical" in index.html was covering.
  "routes": [
    { "pattern": "nodqora.com", "custom_domain": true }
  ]
}
